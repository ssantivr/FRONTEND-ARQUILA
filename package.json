{
    "name": "arquila-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "demo": "vite --mode demo --port 5174 --strictPort --open",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:cobertura": "vitest run --coverage",
        "test:e2e": "playwright test",
        "analizar": "tsc --noEmit && vite build --mode analyze",
        "lint": "eslint .",
        "format": "prettier --write src e2e vite.config.ts playwright.config.ts eslint.config.js",
        "format:check": "prettier --check src e2e vite.config.ts playwright.config.ts eslint.config.js",
        "capturas": "node scripts/capturas.mjs",
        "accesibilidad": "node scripts/accesibilidad.mjs",
        "contraste": "node scripts/contraste.mjs",
        "movimiento": "node scripts/movimiento.mjs",
        "renders": "node scripts/renders.mjs",
        "favicon": "node scripts/favicon.mjs",
        "local:wasm": "node scripts/local-wasm.mjs"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "@fontsource-variable/jetbrains-mono": "5.3.0",
        "@radix-ui/react-dialog": "1.3.1",
        "lucide-react": "1.56.0",
        "polygon-clipping": "0.15.7",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-router": "7.18.4",
        "recharts": "3.10.1",
        "three": "0.186.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.0",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/jest-axe": "3.5.9",
        "@types/node": "24.19.2",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@types/three": "0.186.0",
        "@vitejs/plugin-react": "4.7.0",
        "@vitest/coverage-v8": "5.0.3",
        "axe-core": "4.14.0",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "jest-axe": "11.0.0",
        "jsdom": "30.1.2",
        "msw": "2.15.0",
        "playwright-core": "1.64.0",
        "prettier": "3.9.9",
        "rollup-plugin-visualizer": "7.1.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.0",
        "vite": "6.4.4",
        "vitest": "5.0.3"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "msw": false
    }
}
