# Base URL of the ARQUILA API. Defaults to /api (proxied by Vite in development).
VITE_API_URL=/api
# Optional: backend that the development server forwards /api to. Default: http://localhost:8000
API_PROXY_TARGET=

# Map tiles of the location picker. Empty: no tiles in a build, and in local development
# OpenStreetMap, under its usage policy
# (https://operations.osmfoundation.org/policies/tiles/), which forbids heavy use.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
