# Base URL of the ARQUILA API. Defaults to /api (proxied by Vite in development).
VITE_API_URL=/api
# Local backend. Change only when the API uses another address or port.
API_PROXY_TARGET=http://localhost:8010

# Map tiles of the location picker. Empty: no tiles in a build, and in local development
# OpenStreetMap, under its usage policy
# (https://operations.osmfoundation.org/policies/tiles/), which forbids heavy use.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Quick fill of the local test accounts, development only. Put it in .env.development.local,
# never in Git: "Label|email|password;Label|email|password" (see the database docs).
VITE_TEST_ACCOUNTS=
